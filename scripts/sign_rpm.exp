#!/usr/bin/expect -f
set timeout -1
set rpm_file [lindex $argv 0]
set gpg_name [lindex $argv 1]
set passphrase [lindex $argv 2]

# Set environment
set env(LINES) 24
set env(COLUMNS) 80
set env(TERM) xterm

# Spawn with bash to set terminal size and GPG_TTY for the current PTY
spawn bash -c "stty rows 24 cols 80; export GPG_TTY=\$(tty); rpmsign --define \"_gpg_name $gpg_name\" --addsign $rpm_file"

expect {
    -nocase -re "pass *phrase" {
        send "$passphrase\r"
    }
}
expect eof
