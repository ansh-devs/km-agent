#!/usr/bin/expect -f
set timeout 60
set rpm_file [lindex $argv 0]
set gpg_name [lindex $argv 1]
set passphrase [lindex $argv 2]

set env(GNUPGHOME) $env(HOME)/.gnupg
set env(GPG_TTY) /dev/tty
set env(PINENTRY_MODE) loopback

spawn bash -c "rpm --define \"_gpg_name $gpg_name\" --resign $rpm_file"

expect {
    -nocase "passphrase" {
        send "$passphrase\r"
        exp_continue
    }
    timeout {
        puts "Timeout waiting for passphrase prompt"
        exit 1
    }
    eof
}
