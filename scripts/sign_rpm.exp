#!/usr/bin/expect -f
set timeout -1
set rpm_file [lindex $argv 0]
set gpg_name [lindex $argv 1]
set passphrase [lindex $argv 2]

# Set terminal size to avoid "Screen or window too small" error
exec stty rows 24 cols 80

# Spawn with bash to set GPG_TTY to the current PTY
spawn bash -c "export GPG_TTY=\$(tty); rpmsign --define \"_gpg_name $gpg_name\" --addsign $rpm_file"

expect {
    -nocase "enter pass *phrase:" {
        send "$passphrase\r"
        exp_continue
    }
    eof
}
