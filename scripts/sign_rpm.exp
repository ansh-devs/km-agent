#!/usr/bin/expect -f
set timeout -1
set rpm_file [lindex $argv 0]
set gpg_name [lindex $argv 1]
set passphrase [lindex $argv 2]

# Set environment variables for tools that check them
set env(LINES) 24
set env(COLUMNS) 80
set env(TERM) xterm

# Spawn rpmsign
spawn rpmsign --define "_gpg_name $gpg_name" --addsign $rpm_file

# Point GPG to the PTY created by expect
set env(GPG_TTY) $spawn_out(slave,name)

# Set terminal size for the PTY we just spawned
exec stty rows 24 cols 80 < $spawn_out(slave,name)

expect {
    -nocase -re "pass *phrase" {
        send "$passphrase\r"
        exp_continue
    }
    eof
}
